# CMake build products and local configuration
/build/
CMakeUserPresets.json

# Node dependencies and generated package-manager diagnostics
/tools/mcp-bridge/node_modules/
npm-debug.log*

# Scratch asset folder for project-less sessions; smoke tests stage fixture models here.
/assets/
# Generated import caches beside the test fixture models.
/tests/fixtures/models/.relay-imports.json
/tests/fixtures/models/.relay-cache/

# Local runtime output
/outputs/
/work/
/traces/

# Captures are generated artifacts. Keep the two representative images
# referenced by HANDOFF.md as project documentation.
/captures/*
!/captures/bindless-scene.png
!/captures/imported-gltf.png
!/captures/depth-occlusion.png
!/captures/pbr-golden.png

# Editor and operating-system noise
# Private bridge provider authentication, editor settings, audits and temporary/backup files
/.relay/
.DS_Store
*.swp
*.tmp

# Python smoke-test bytecode
__pycache__/
*.py[cod]
