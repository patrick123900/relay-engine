shader_type surface;

// Plasma orb: swirling bands of energy glowing inside a dark glassy shell, with a bright rim and
// a surface that ripples as if it can barely hold them. It hovers, each orb at its own pace.
// Emission far above 1.0 makes it glow through Bloom. Each orb in the demo gives the same material
// its own colors (This object only).
uniform vec3 core_color : source_color = vec3(1.0, 0.3, 0.03);
uniform vec3 glow_color : source_color = vec3(0.05, 0.3, 1.0);
uniform float energy : hint_range(0.0, 30.0) = 5.0;
uniform float flow_speed : hint_range(0.0, 3.0) = 0.5;
uniform float swirl : hint_range(0.0, 8.0) = 3.5;
uniform float ripple : hint_range(0.0, 0.2) = 0.035;
uniform float hover : hint_range(0.0, 0.5) = 0.12;

// Smooth random values in space, from 0 to 1.
float hash(vec3 p) {
    p = fract(p * 0.3183099 + 0.1);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise(vec3 p) {
    vec3 cell = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(mix(hash(cell), hash(cell + vec3(1, 0, 0)), f.x),
                   mix(hash(cell + vec3(0, 1, 0)), hash(cell + vec3(1, 1, 0)), f.x), f.y),
               mix(mix(hash(cell + vec3(0, 0, 1)), hash(cell + vec3(1, 0, 1)), f.x),
                   mix(hash(cell + vec3(0, 1, 1)), hash(cell + vec3(1, 1, 1)), f.x), f.y), f.z);
}

// Noise at several sizes added together, for detail within detail.
float layered_noise(vec3 p) {
    float sum = 0.0;
    float amount = 0.5;
    for (int octave = 0; octave < 5; octave++) {
        sum += noise(p) * amount;
        p = p * 2.03 + vec3(1.7, 9.2, 3.1);
        amount *= 0.5;
    }
    return sum;
}

// Noise whose position is pushed around by more noise, which makes it swirl like plasma.
float plasma(vec3 p, float t, float twist) {
    vec3 push = vec3(layered_noise(p + vec3(0.0, 0.0, t)),
                     layered_noise(p + vec3(5.2, 1.3, -t)),
                     layered_noise(p + vec3(1.7, 9.2, t * 0.7)));
    return layered_noise(p + push * twist);
}

// Where the object is: its model matrix's translation.
vec3 object_centre(mat4 model) {
    return model[3].xyz;
}

void vertex() {
    float wave = sin(TIME * 3.0 + layered_noise(VERTEX * 4.0 + TIME * flow_speed) * 12.0);
    vec3 centre = object_centre(MODEL_MATRIX);
    float bob = sin(TIME * 1.4 + centre.x * 2.0 + centre.z) * hover;
    VERTEX += NORMAL * wave * ripple + vec3(0.0, bob, 0.0);
}

void fragment() {
    vec3 local = WORLD_POSITION - object_centre(MODEL_MATRIX);
    float flow = TIME * flow_speed;
    float pattern = plasma(local * 2.2, flow, swirl);
    float bands = pow(smoothstep(0.3, 0.8, pattern), 3.0);
    vec3 plasma_color = mix(glow_color, core_color, smoothstep(0.45, 0.7, pattern));
    float facing = clamp(dot(normalize(NORMAL), VIEW), 0.0, 1.0);
    float rim = pow(1.0 - facing, 3.0);
    float pulse = 0.8 + 0.2 * sin(TIME * 2.3);
    ALBEDO = vec3(0.02);
    ROUGHNESS = 0.08;
    METALLIC = 0.0;
    EMISSION = (plasma_color * bands + glow_color * rim * 0.6) * energy * pulse;
}
