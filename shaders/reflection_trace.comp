#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Traces one reflection ray for each pixel the FidelityFX classifier listed, and shades what it
// hits with the same material and light code as the raster pass. Writes radiance and hit
// distance for the FidelityFX reflection denoiser, copying to the neighbours the classifier
// asked to share this ray.

layout(local_size_x = 32) in;

float surface_lod = 0.0;
#define SURFACE_TEXTURE(index, uv) textureLod(textures[nonuniformEXT(index)], uv, surface_lod)
#include "surface_lighting.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT scene;
#include "reflection_trace_common.glsl"

// Particle sprites, as particle.vert reads them, with each sprite's right and up axes (the CPU
// orients the quads the acceleration structure holds), the batches that say how to draw them
// (sorted by first sprite) and the batches' textures.
struct SpriteData {
    vec4 position_width;
    vec4 axis_height;
    vec4 color;
    vec4 rotation_frame_age;
};
layout(std430, set = 1, binding = 12) readonly buffer Sprites { SpriteData sprites[]; };
struct BatchData {
    // first sprite, sprite count, texture slot, mode: blend | lit << 4 | flipbook blend << 5.
    uvec4 range;
    vec4 local_x; // w: flipbook columns
    vec4 local_y; // w: flipbook rows
    vec4 padding;
};
layout(std430, set = 1, binding = 13) readonly buffer Batches { BatchData batches[]; };
layout(std430, set = 1, binding = 14) readonly buffer SpriteAxes { vec4 sprite_axes[]; };
layout(set = 1, binding = 15) uniform sampler2D particle_images[16];

const float max_distance = 1000.0;
// Hit distance reported for rays that leave the scene, as in AMD's sample.
const float sky_distance = 100.0;

vec3 environment(vec3 direction) {
    // The sky as global illumination sees it: the ambient scale divided by pi, which with a sky
    // is its visible radiance times the ambient intensity.
    return sky_environment(direction) / pi;
}

// Particle sprites are non-opaque quads the ray query reports as candidates. Each one found is
// shaded as particle.frag does (without the soft-particle fade, which needs the screen's depth) and
// kept, nearest four, to be blended over whatever the ray ends on.
const int max_layers = 4;

// Premultiplied color and coverage: alpha sprites cover, additive ones (coverage 0) add light.
vec4 particle_layer(uint sprite_index, uint triangle, vec2 barycentrics, vec3 hit_position, vec3 direction,
                    float distance) {
    uint low = 0u;
    uint high = trace.extent.w & 0x7FFFFFFFu;
    while (high - low > 1u) {
        uint middle = (low + high) / 2u;
        if (batches[middle].range.x <= sprite_index) low = middle;
        else high = middle;
    }
    BatchData batch = batches[low];
    if (sprite_index < batch.range.x || sprite_index >= batch.range.x + batch.range.y) return vec4(0.0);
    SpriteData sprite = sprites[sprite_index];
    vec3 weights = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics);
    // The quad's corners are (-1,-1), (1,-1), (1,1), (-1,1); the triangles (0,1,2) and (0,2,3).
    vec2 corner = triangle == 0u
        ? weights.x * vec2(-1.0, -1.0) + weights.y * vec2(1.0, -1.0) + weights.z * vec2(1.0, 1.0)
        : weights.x * vec2(-1.0, -1.0) + weights.y * vec2(1.0, 1.0) + weights.z * vec2(-1.0, 1.0);
    vec2 uv = vec2(corner.x * 0.5 + 0.5, 0.5 - corner.y * 0.5);
    float columns = batch.local_x.w;
    float rows = batch.local_y.w;
    float frames = columns * rows;
    float current = floor(sprite.rotation_frame_age.y);
    vec2 cell = vec2(mod(current, columns), floor(current / columns));
    vec2 frame_uv = (cell + uv) / vec2(columns, rows);
    float lod = clamp(log2(1.0 + distance), 0.0, 4.0);
    uint slot = batch.range.z;
    vec4 texel = textureLod(particle_images[nonuniformEXT(slot)], frame_uv, lod);
    if ((batch.range.w & 32u) != 0u) {
        float next = mod(current + 1.0, frames);
        vec2 next_cell = vec2(mod(next, columns), floor(next / columns));
        texel = mix(texel, textureLod(particle_images[nonuniformEXT(slot)], (next_cell + uv) / vec2(columns, rows), lod),
                    fract(sprite.rotation_frame_age.y));
    }
    uint blend = batch.range.w & 15u;
    vec3 color = sprite.color.rgb * texel.rgb;
    float alpha = sprite.color.a * texel.a;
    if (alpha <= 0.002 && blend != 2u) return vec4(0.0);
    if ((batch.range.w & 16u) != 0u) {
        vec3 right = sprite_axes[sprite_index * 2u].xyz;
        vec3 up = sprite_axes[sprite_index * 2u + 1u].xyz;
        vec3 facing = normalize(cross(right, up));
        vec3 view_direction = -direction;
        if (dot(facing, view_direction) < 0.0) facing = -facing;
        float edge = clamp(dot(corner, corner), 0.0, 1.0);
        Surface surface;
        surface.base_color = vec4(blend == 2u ? color / max(alpha, 0.001) : color, 1.0);
        surface.metallic = 0.0;
        surface.roughness = 1.0;
        surface.normal = normalize(right * corner.x + up * corner.y + facing * sqrt(1.0 - edge));
        surface.occlusion = 1.0;
        surface.emissive = vec3(0.0);
        vec3 total, diffuse;
        direct_lighting(surface, hit_position, view_direction, total, diffuse);
        vec3 lit = total + ambient_diffuse(surface);
        color = blend == 2u ? lit * alpha : lit;
    }
    float fog = fog_amount(length(hit_position - trace.camera_position.xyz));
    if (blend == 1u) return vec4(color * alpha * (1.0 - fog), 0.0);
    if (blend == 2u) return vec4(mix(color, fog_color(fog) * alpha, fog), alpha);
    return vec4(mix(color, fog_color(fog), fog) * alpha, alpha);
}

void main() {
    uint ray_index = gl_GlobalInvocationID.x;
    if (ray_index >= counter[5]) return;
    uint packed = rays[ray_index];
    ivec2 pixel = ivec2(packed & 32767u, (packed >> 15u) & 16383u);
    bool copy_horizontal = ((packed >> 29u) & 1u) != 0u;
    bool copy_vertical = ((packed >> 30u) & 1u) != 0u;
    bool copy_diagonal = ((packed >> 31u) & 1u) != 0u;

    vec3 origin, direction;
    reflection_ray(pixel, origin, direction);
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsNoneEXT, 0xFFu, origin, 0.0, direction,
                          max_distance);
    float layer_distance[max_layers];
    vec4 layer_color[max_layers];
    int layers = 0;
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT) continue;
        InstanceData candidate = instances[rayQueryGetIntersectionInstanceCustomIndexEXT(query, false)];
        if (candidate.deformed != 2u) {
            rayQueryConfirmIntersectionEXT(query);
            continue;
        }
        float candidate_distance = rayQueryGetIntersectionTEXT(query, false);
        uint candidate_primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, false));
        vec4 layer = particle_layer(candidate_primitive >> 1u, candidate_primitive & 1u,
                                    rayQueryGetIntersectionBarycentricsEXT(query, false),
                                    origin + direction * candidate_distance, direction, candidate_distance);
        if (layer == vec4(0.0)) continue;
        // Keep the nearest few, nearest first.
        int place = layers < max_layers ? layers : max_layers - 1;
        if (layers == max_layers && candidate_distance >= layer_distance[max_layers - 1]) continue;
        while (place > 0 && layer_distance[place - 1] > candidate_distance) {
            layer_distance[place] = layer_distance[place - 1];
            layer_color[place] = layer_color[place - 1];
            --place;
        }
        layer_distance[place] = candidate_distance;
        layer_color[place] = layer;
        layers = min(layers + 1, max_layers);
    }
    float opaque_distance = max_distance;
    vec4 result;
    bool keep_hits = (trace.extent.w & 0x80000000u) != 0u;
    if (keep_hits) hit_records[ray_index * 4u] = no_hit;
    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        float distance = rayQueryGetIntersectionTEXT(query, true);
        opaque_distance = distance;
        uint instance_index = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        InstanceData instance = instances[instance_index];
        uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
        // A custom shader's surface is shaded again by that shader's hit kernel; what follows, with
        // the instance's stand-in material, is what shows where there is none.
        if (keep_hits && instance.extra.x != 0u) {
            uvec2 fractions = uvec2(clamp(barycentrics, vec2(0.0), vec2(1.0)) * 65535.0 + 0.5);
            hit_records[ray_index * 4u] = instance_index;
            hit_records[ray_index * 4u + 1u] = primitive;
            hit_records[ray_index * 4u + 2u] = fractions.x | (fractions.y << 16u);
            hit_records[ray_index * 4u + 3u] = floatBitsToUint(distance);
        }
        vec3 weights = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics);
        uint first = instance.first_index + primitive * 3u;
        uvec3 corners = uvec3(uint(int(indices[first]) + instance.vertex_offset),
                              uint(int(indices[first + 1u]) + instance.vertex_offset),
                              uint(int(indices[first + 2u]) + instance.vertex_offset));
        vec2 hit_uv = vertex_uv(instance, corners.x) * weights.x +
                      vertex_uv(instance, corners.y) * weights.y +
                      vertex_uv(instance, corners.z) * weights.z;
        vec3 object_normal = vertex_vector(instance, corners.x, 5u) * weights.x +
                             vertex_vector(instance, corners.y, 5u) * weights.y +
                             vertex_vector(instance, corners.z, 5u) * weights.z;
        vec4 object_tangent = vertex_vector4(instance, corners.x, 8u) * weights.x +
                              vertex_vector4(instance, corners.y, 8u) * weights.y +
                              vertex_vector4(instance, corners.z, 8u) * weights.z;
        mat4x3 object_to_world = rayQueryGetIntersectionObjectToWorldEXT(query, true);
        mat4x3 world_to_object = rayQueryGetIntersectionWorldToObjectEXT(query, true);
        vec3 world_normal = normalize(transpose(mat3(world_to_object)) * object_normal);
        vec4 world_tangent = vec4(normalize(mat3(object_to_world) * object_tangent.xyz),
                                  object_tangent.w < 0.0 ? -1.0 : 1.0);
        bool front_facing = rayQueryGetIntersectionFrontFaceEXT(query, true);
        // Coarser texture levels further along the ray, where a texel covers more of the image.
        surface_lod = clamp(log2(1.0 + distance), 0.0, 6.0);
        Surface surface = evaluate_surface(instance.material, hit_uv, world_normal, world_tangent,
                                           front_facing);
        vec3 hit_position = origin + direction * distance;
        vec3 direct_total;
        vec3 direct_diffuse;
        direct_lighting(surface, hit_position, -direction, direct_total, direct_diffuse);
        vec3 radiance = direct_total + ambient_lighting(surface, -direction) + surface.emissive;
        result = vec4(radiance, distance);
    } else {
        result = vec4(environment(direction), sky_distance);
    }
    // Particles in front of what the ray ended on, farthest first.
    for (int layer = layers - 1; layer >= 0; --layer)
        if (layer_distance[layer] < opaque_distance)
            result.rgb = layer_color[layer].rgb + result.rgb * (1.0 - layer_color[layer].a);
    // A single NaN would spread through the denoiser's history, so such a ray is dropped.
    if (any(isnan(result))) return;
    result.rgb = min(result.rgb, vec3(64.0));
    store(pixel, result);
    if (copy_horizontal) store(pixel ^ ivec2(1, 0), result);
    if (copy_vertical) store(pixel ^ ivec2(0, 1), result);
    if (copy_diagonal) store(pixel ^ ivec2(1, 1), result);
}
