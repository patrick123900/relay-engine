# Writes a C++ source holding binary files as byte arrays, for data the engine carries inside its
# library, such as the game interface's built-in font.
# Usage: cmake -DOUTPUT=<file.cpp> -DINPUTS=<a.ttf;b.ttf> -P embed_binary_files.cmake
set(content "// Generated by tools/embed_binary_files.cmake; do not edit.\n")
string(APPEND content "#include \"relay/ui/ui_font.hpp\"\n\nnamespace relay {\nnamespace {\n\n")
set(index 0)
set(entries "")
foreach(input IN LISTS INPUTS)
    get_filename_component(name "${input}" NAME)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" length)
    string(APPEND content "const unsigned char file_${index}[] = {\n")
    # Short lines keep every compiler's source line limits happy.
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${hex}" ${offset} 64 piece)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," piece "${piece}")
        string(APPEND content "${piece}\n")
        math(EXPR offset "${offset} + 64")
    endwhile()
    string(APPEND content "};\n\n")
    string(APPEND entries "        {\"${name}\", {file_${index}, sizeof file_${index}}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "} // namespace\n\n")
string(APPEND content "const std::vector<EmbeddedFile>& embedded_files() {\n")
string(APPEND content "    static const std::vector<EmbeddedFile> files{\n${entries}    };\n")
string(APPEND content "    return files;\n}\n\n} // namespace relay\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
