# Writes a C++ source holding shader include files as strings, so Relay can compile project
# shaders at runtime against the same scene bindings and lighting code as its built-in shaders.
# Usage: cmake -DOUTPUT=<file.cpp> -DINPUTS=<a.glsl;b.glsl> -P embed_shader_sources.cmake
set(content "// Generated by tools/embed_shader_sources.cmake from shaders/; do not edit.\n")
string(APPEND content "#include \"relay/render/shader_language.hpp\"\n\nnamespace relay {\n\n")
string(APPEND content "const std::vector<EmbeddedShaderSource>& embedded_shader_sources() {\n")
string(APPEND content "    static const std::vector<EmbeddedShaderSource> sources{\n")
foreach(input IN LISTS INPUTS)
    get_filename_component(name "${input}" NAME)
    file(READ "${input}" text)
    string(LENGTH "${text}" length)
    string(APPEND content "        {\"${name}\",\n")
    # Raw string pieces stay short for compilers with string literal limits.
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${text}" ${offset} 4000 piece)
        string(APPEND content "         R\"relay_glsl(${piece})relay_glsl\"\n")
        math(EXPR offset "${offset} + 4000")
    endwhile()
    string(APPEND content "        },\n")
endforeach()
string(APPEND content "    };\n    return sources;\n}\n\n} // namespace relay\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
